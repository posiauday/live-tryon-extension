{
  "manifest_version": 3,
  "name": "Live Virtual Try-On Pro",
  "version": "0.4.0",
  "description": "Prototype live webcam-based virtual try-on Chrome extension.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Live Virtual Try-On",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "host_permissions": [
    "https://*.decart.ai/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
